    <!-- Indoor-temperature calibration (Options tab) -->
    <string name="section_calibration">Βαθμονόμηση εσωτερικής θερμοκρασίας</string>
    <string name="calibration_hint">Πολλές μονάδες δείχνουν έναν-δύο βαθμούς απόκλιση από την πραγματική θερμοκρασία του δωματίου. Σύγκρινε με ένα θερμόμετρο δωματίου και διόρθωσε εδώ την ένδειξη. Η εφαρμογή θα εμφανίζει παντού τη διορθωμένη τιμή, σημειωμένη με ένα μικρό πορτοκαλί δέλτα, και θα μετατοπίζει την επιθυμητή θερμοκρασία που στέλνει στη μονάδα κατά τους ίδιους ακέραιους βαθμούς — ώστε το δωμάτιο να φτάνει πραγματικά αυτό που όρισες. Αποθηκεύεται για αυτήν τη συσκευή.</string>
    <string name="calibration_none">χωρίς διόρθωση</string>
    <string name="calibration_preview">Μετρήθηκε %1$s → εμφανίζεται %2$s</string>
    <string name="calibration_device_target">Στη μονάδα στέλνεται: %1$s — στόχος %2$s</string>
    <string name="calibration_no_reading">Αναμονή για την πρώτη μέτρηση…</string>
    <string name="calibration_reset">Επαναφορά στο 0</string>
    <string name="calibration_less">Μείωση της διόρθωσης</string>
    <string name="calibration_more">Αύξηση της διόρθωσης</string>

