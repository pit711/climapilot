    <!-- Indoor-temperature calibration (Options tab) -->
    <string name="section_calibration">Kalibracja temperatury wewnętrznej</string>
    <string name="calibration_hint">Wiele urządzeń wskazuje temperaturę o stopień lub dwa inną niż rzeczywista temperatura w pomieszczeniu. Porównaj odczyt z termometrem pokojowym i skoryguj go tutaj. Aplikacja będzie wtedy wszędzie pokazywać skorygowaną wartość, oznaczoną małą bursztynową deltą, i przesunie wysyłaną do urządzenia temperaturę zadaną o te same pełne stopnie — dzięki temu w pomieszczeniu naprawdę będzie tyle, ile ustawisz. Zapisywane dla tego urządzenia.</string>
    <string name="calibration_none">bez korekty</string>
    <string name="calibration_preview">Zmierzone %1$s → wyświetlane %2$s</string>
    <string name="calibration_device_target">Wysyłane do urządzenia: %1$s — cel %2$s</string>
    <string name="calibration_no_reading">Oczekiwanie na pierwszy odczyt…</string>
    <string name="calibration_reset">Zresetuj do 0</string>
